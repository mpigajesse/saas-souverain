# Variables lues par config/settings.py via python-decouple.
# Copier en `.env` et remplir — SECRET_KEY, DB_NAME, DB_USER et DB_PASSWORD
# n'ont pas de valeur par défaut : sans elles, Django refuse de démarrer.
# Écrire le fichier en UTF-8 SANS BOM : decouple ne reconnaît pas la première
# clé si un BOM la précède (« SECRET_KEY not found » alors que la ligne existe).
# Le vrai .env est gitignoré (règle n°6 — aucun secret committé).

SECRET_KEY=changez-moi-50-caracteres-aleatoires
DEBUG=True

# Ouverture au reseau local (banc de test) : le PC de l'editeur sert de serveur
# aux autres machines du reseau, qui le joignent par son IP. « * » accepte
# n'importe quel en-tete Host — commode quand l'IP change (DHCP, bascule
# Wi-Fi/Ethernet), mais c'est un RELACHEMENT ASSUME, valable seulement sur un
# reseau de test maitrise. En production, lister les hotes reels.
# Laisse vide, config/settings.py detecte automatiquement les IP locales.
ALLOWED_HOSTS=*

# PostgreSQL du SaaS éditeur (cluster Patroni du docker-compose.yml à la racine).
# DB_PORT=5434 : port de secours du conteneur postgres-primary. Sur un poste où
# aucun PostgreSQL natif n'occupe 5432, 5432 fonctionne aussi.
DB_NAME=saas_editor
DB_USER=amane_admin
DB_PASSWORD=changez-moi
DB_HOST=localhost
DB_PORT=5434

# Relais éditeur joignable depuis les conteneurs PME
RELAY_URL=http://host.docker.internal:8080

# Port du registre Docker de l'éditeur (service compose `registry`) où les
# machines PME tirent l'image du nœud. Seul le PORT est configuré : l'hôte est
# toujours dérivé de la requête entrante, car il dépend de l'IP par laquelle la
# PME a joint l'éditeur.
REGISTRY_PORT=5000

# Image Docker du nœud PME distribuée aux tenants. Le marqueur « {registry} »
# est remplacé à la volée par « <IP de l'éditeur vue par la PME>:<REGISTRY_PORT> »
# dans le docker-compose.yml et les installeurs générés.
SS_NODE_IMAGE={registry}/ss-node:v2

# Origines autorisées à appeler l'API en cookies de session (CORS + CSRF) —
# la console React (Vite dev server). Liste séparée par des virgules, sans
# CORS_ALLOW_ALL_ORIGINS : incompatible avec les cookies de session.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,http://127.0.0.1
