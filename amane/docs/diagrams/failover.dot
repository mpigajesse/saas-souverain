digraph failover {
  rankdir=TB;
  graph [fontname="Helvetica", fontsize=11, fontcolor="#0b3d66", label="Superviseur (option C) — failover < 5 s",
         labelloc=t, pad=0.4];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled",
         fillcolor="#eef4fa", color="#4a7196"];
  edge  [fontname="Helvetica", fontsize=9, color="#4a7196"];

  subgraph cluster_det {
    label="Détection (par nœud superviseur)";
    style=filled; fillcolor="#f7fafd"; color="#4a7196";
    probe [label="probe REST Patroni\ntoutes les 500 ms", fillcolor="#fffde7", color="#b07c1a"];
    hb    [label="agent heartbeat LOCAL\nisole ses pairs\n/amane/supervisor/hb/<nom>\nlease 2 s", fillcolor="#e3f2fd", color="#1565c0"];
    eval  [label="règle de décision", shape=diamond, fillcolor="#fffde7", color="#b07c1a"];
  }

  healthy [label="leader REST joignable\n→ rien à faire", fillcolor="#e8f5e9", color="#2e7d32"];
  guard   [label="REST down MAIS\nheartbeat frais (partition partielle)\n→ JAMAIS de forçage\nPatroni tranche", fillcolor="#ffebee", color="#c62828"];
  crash   [label="REST down ET\nheartbeat stale (2 ticks)\n→ crash suspecté", fillcolor="#fff3e0", color="#e65100"];

  release [label="libération du lock Patroni\nsuppression /service/amane/leader", fillcolor="#ede7f6", color="#5e35b1"];
  post    [label="POST /failover\n(sans le champ leader)\n→ candidat réplica sync", fillcolor="#ede7f6", color="#5e35b1"];
  patroni [label="Patroni promeut (zéro perte)\n→ primary : ~3,2 s (crash) / ~3,0 s (coupure)",
           fillcolor="#e8f5e9", color="#2e7d32"];

  probe -> eval;
  hb    -> eval [label="heartbeat lu dans etcd"];
  eval  -> healthy;
  eval  -> guard;
  eval  -> crash;
  crash -> release;
  release -> post;
  post -> patroni;

  patient [label="lock « droit de forcer »\n/amane/supervisor/force-right\n(élection : un seul actif)", shape=cylinder, fillcolor="#fff8e1", color="#b07c1a"];
  patient -> post [style=dotted, label="verrou requis (anti SPOF)"];
}