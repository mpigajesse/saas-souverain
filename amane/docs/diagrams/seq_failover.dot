digraph seq_failover {
  rankdir=TB;
  graph [fontname="Helvetica", fontsize=11, fontcolor="#0b3d66", label="Séquence — failover sur crash (superviseur, cible < 5 s)", labelloc=t, pad=0.4, splines=polyline];
  node [fontname="Helvetica", fontsize=9, shape=point, width=0.02, height=0.02];
  edge [fontname="Helvetica", fontsize=8, color="#4a7196", arrowsize=0.7];
  H_pri [label="postgres-primary", shape=box, style="rounded,filled", fillcolor="#e8f5e9", color="#2a4a66", fontname="Helvetica-Bold", fontsize=10];
  H_sup [label="Superviseur (réplica)", shape=box, style="rounded,filled", fillcolor="#ede7f6", color="#2a4a66", fontname="Helvetica-Bold", fontsize=10];
  H_etd [label="etcd (heartbeats + lock)", shape=box, style="rounded,filled", fillcolor="#fff8e1", color="#2a4a66", fontname="Helvetica-Bold", fontsize=10];
  H_pat [label="Patroni / candidat sync", shape=box, style="rounded,filled", fillcolor="#e3f2fd", color="#2a4a66", fontname="Helvetica-Bold", fontsize=10];
  pri_1 [label="", shape=point, width=0.01, height=0.01];
  H_pri -> pri_1 [style=invis, constraint=true];
  pri_2 [label="", shape=point, width=0.01, height=0.01];
  pri_1 -> pri_2 [style=invis, constraint=true];
  pri_3 [label="", shape=point, width=0.01, height=0.01];
  pri_2 -> pri_3 [style=invis, constraint=true];
  pri_4 [label="", shape=point, width=0.01, height=0.01];
  pri_3 -> pri_4 [style=invis, constraint=true];
  pri_5 [label="", shape=point, width=0.01, height=0.01];
  pri_4 -> pri_5 [style=invis, constraint=true];
  pri_6 [label="", shape=point, width=0.01, height=0.01];
  pri_5 -> pri_6 [style=invis, constraint=true];
  pri_7 [label="", shape=point, width=0.01, height=0.01];
  pri_6 -> pri_7 [style=invis, constraint=true];
  pri_8 [label="", shape=point, width=0.01, height=0.01];
  pri_7 -> pri_8 [style=invis, constraint=true];
  sup_1 [label="", shape=point, width=0.01, height=0.01];
  H_sup -> sup_1 [style=invis, constraint=true];
  sup_2 [label="", shape=point, width=0.01, height=0.01];
  sup_1 -> sup_2 [style=invis, constraint=true];
  sup_3 [label="", shape=point, width=0.01, height=0.01];
  sup_2 -> sup_3 [style=invis, constraint=true];
  sup_4 [label="", shape=point, width=0.01, height=0.01];
  sup_3 -> sup_4 [style=invis, constraint=true];
  sup_5 [label="", shape=point, width=0.01, height=0.01];
  sup_4 -> sup_5 [style=invis, constraint=true];
  sup_6 [label="", shape=point, width=0.01, height=0.01];
  sup_5 -> sup_6 [style=invis, constraint=true];
  sup_7 [label="", shape=point, width=0.01, height=0.01];
  sup_6 -> sup_7 [style=invis, constraint=true];
  sup_8 [label="", shape=point, width=0.01, height=0.01];
  sup_7 -> sup_8 [style=invis, constraint=true];
  etd_1 [label="", shape=point, width=0.01, height=0.01];
  H_etd -> etd_1 [style=invis, constraint=true];
  etd_2 [label="", shape=point, width=0.01, height=0.01];
  etd_1 -> etd_2 [style=invis, constraint=true];
  etd_3 [label="", shape=point, width=0.01, height=0.01];
  etd_2 -> etd_3 [style=invis, constraint=true];
  etd_4 [label="", shape=point, width=0.01, height=0.01];
  etd_3 -> etd_4 [style=invis, constraint=true];
  etd_5 [label="", shape=point, width=0.01, height=0.01];
  etd_4 -> etd_5 [style=invis, constraint=true];
  etd_6 [label="", shape=point, width=0.01, height=0.01];
  etd_5 -> etd_6 [style=invis, constraint=true];
  etd_7 [label="", shape=point, width=0.01, height=0.01];
  etd_6 -> etd_7 [style=invis, constraint=true];
  etd_8 [label="", shape=point, width=0.01, height=0.01];
  etd_7 -> etd_8 [style=invis, constraint=true];
  pat_1 [label="", shape=point, width=0.01, height=0.01];
  H_pat -> pat_1 [style=invis, constraint=true];
  pat_2 [label="", shape=point, width=0.01, height=0.01];
  pat_1 -> pat_2 [style=invis, constraint=true];
  pat_3 [label="", shape=point, width=0.01, height=0.01];
  pat_2 -> pat_3 [style=invis, constraint=true];
  pat_4 [label="", shape=point, width=0.01, height=0.01];
  pat_3 -> pat_4 [style=invis, constraint=true];
  pat_5 [label="", shape=point, width=0.01, height=0.01];
  pat_4 -> pat_5 [style=invis, constraint=true];
  pat_6 [label="", shape=point, width=0.01, height=0.01];
  pat_5 -> pat_6 [style=invis, constraint=true];
  pat_7 [label="", shape=point, width=0.01, height=0.01];
  pat_6 -> pat_7 [style=invis, constraint=true];
  pat_8 [label="", shape=point, width=0.01, height=0.01];
  pat_7 -> pat_8 [style=invis, constraint=true];
  pri_1 -> pri_1 [label="#crash# : SIGKILL (aucun nettoyage)", constraint=false, style=dashed, dir=forward, color="#c62828"];
  etd_2 -> sup_2 [label="heartbeat primary + REST en échec (500 ms)", constraint=false, style=dashed, color="#999"];
  sup_3 -> sup_3 [label="StaleConfirm = 2 ticks → crash confirmé", constraint=false, style=dashed, dir=forward, color="#e65100"];
  sup_4 -> etd_4 [label="DELETE /service/amane/leader (libération du lock)", constraint=false, style=solid];
  sup_5 -> pat_5 [label="POST /failover (SANS le champ leader)", constraint=false, style=solid, color="#c62828"];
  pat_6 -> etd_6 [label="recapture du lock + promotion", constraint=false, style=dashed, color="#999"];
  etd_7 -> pri_7 [label="fencing : l'ancien primary ne recapture jamais", constraint=false, style=dashed, color="#999", dir=forward];
  pat_8 -> sup_8 [label="ok — failover ≈ 3,2 s (détection 0,8 s)", constraint=false, style=dashed, color="#2e7d32"];
  NOTE_4 [label="force=true seul insuffisant : sans la
libération du lock, la promotion resterait
bornée par ttl >= 20 s", shape=note, fontsize=8, style="rounded,filled", fillcolor="#fff3e0", color="#e65100"];
  { rank=same; pri_1; sup_1; etd_1; pat_1; }
  { rank=same; pri_2; sup_2; etd_2; pat_2; }
  { rank=same; pri_3; sup_3; etd_3; pat_3; }
  { rank=same; pri_4; sup_4; etd_4; pat_4; NOTE_4; }
  { rank=same; pri_5; sup_5; etd_5; pat_5; }
  { rank=same; pri_6; sup_6; etd_6; pat_6; }
  { rank=same; pri_7; sup_7; etd_7; pat_7; }
  { rank=same; pri_8; sup_8; etd_8; pat_8; }
}