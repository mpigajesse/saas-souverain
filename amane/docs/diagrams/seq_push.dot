digraph seq_push {
  rankdir=TB;
  graph [fontname="Helvetica", fontsize=11, fontcolor="#0b3d66", label="Séquence — réplication multi-site PushDelta (garantie AP)", labelloc=t, pad=0.4, splines=polyline];
  node [fontname="Helvetica", fontsize=9, shape=point, width=0.02, height=0.02];
  edge [fontname="Helvetica", fontsize=8, color="#4a7196", arrowsize=0.7];
  H_rel1 [label="Relay A (atelier)", shape=box, style="rounded,filled", fillcolor="#ede7f6", color="#2a4a66", fontname="Helvetica-Bold", fontsize=10];
  H_pro1 [label="Propagateur A", shape=box, style="rounded,filled", fillcolor="#e3f2fd", color="#2a4a66", fontname="Helvetica-Bold", fontsize=10];
  H_srv2 [label="gRPC serveur B", shape=box, style="rounded,filled", fillcolor="#e3f2fd", color="#2a4a66", fontname="Helvetica-Bold", fontsize=10];
  H_rel2 [label="Relay B (eshop)", shape=box, style="rounded,filled", fillcolor="#ede7f6", color="#2a4a66", fontname="Helvetica-Bold", fontsize=10];
  rel1_1 [label="", shape=point, width=0.01, height=0.01];
  H_rel1 -> rel1_1 [style=invis, constraint=true];
  rel1_2 [label="", shape=point, width=0.01, height=0.01];
  rel1_1 -> rel1_2 [style=invis, constraint=true];
  rel1_3 [label="", shape=point, width=0.01, height=0.01];
  rel1_2 -> rel1_3 [style=invis, constraint=true];
  rel1_4 [label="", shape=point, width=0.01, height=0.01];
  rel1_3 -> rel1_4 [style=invis, constraint=true];
  rel1_5 [label="", shape=point, width=0.01, height=0.01];
  rel1_4 -> rel1_5 [style=invis, constraint=true];
  rel1_6 [label="", shape=point, width=0.01, height=0.01];
  rel1_5 -> rel1_6 [style=invis, constraint=true];
  pro1_1 [label="", shape=point, width=0.01, height=0.01];
  H_pro1 -> pro1_1 [style=invis, constraint=true];
  pro1_2 [label="", shape=point, width=0.01, height=0.01];
  pro1_1 -> pro1_2 [style=invis, constraint=true];
  pro1_3 [label="", shape=point, width=0.01, height=0.01];
  pro1_2 -> pro1_3 [style=invis, constraint=true];
  pro1_4 [label="", shape=point, width=0.01, height=0.01];
  pro1_3 -> pro1_4 [style=invis, constraint=true];
  pro1_5 [label="", shape=point, width=0.01, height=0.01];
  pro1_4 -> pro1_5 [style=invis, constraint=true];
  pro1_6 [label="", shape=point, width=0.01, height=0.01];
  pro1_5 -> pro1_6 [style=invis, constraint=true];
  srv2_1 [label="", shape=point, width=0.01, height=0.01];
  H_srv2 -> srv2_1 [style=invis, constraint=true];
  srv2_2 [label="", shape=point, width=0.01, height=0.01];
  srv2_1 -> srv2_2 [style=invis, constraint=true];
  srv2_3 [label="", shape=point, width=0.01, height=0.01];
  srv2_2 -> srv2_3 [style=invis, constraint=true];
  srv2_4 [label="", shape=point, width=0.01, height=0.01];
  srv2_3 -> srv2_4 [style=invis, constraint=true];
  srv2_5 [label="", shape=point, width=0.01, height=0.01];
  srv2_4 -> srv2_5 [style=invis, constraint=true];
  srv2_6 [label="", shape=point, width=0.01, height=0.01];
  srv2_5 -> srv2_6 [style=invis, constraint=true];
  rel2_1 [label="", shape=point, width=0.01, height=0.01];
  H_rel2 -> rel2_1 [style=invis, constraint=true];
  rel2_2 [label="", shape=point, width=0.01, height=0.01];
  rel2_1 -> rel2_2 [style=invis, constraint=true];
  rel2_3 [label="", shape=point, width=0.01, height=0.01];
  rel2_2 -> rel2_3 [style=invis, constraint=true];
  rel2_4 [label="", shape=point, width=0.01, height=0.01];
  rel2_3 -> rel2_4 [style=invis, constraint=true];
  rel2_5 [label="", shape=point, width=0.01, height=0.01];
  rel2_4 -> rel2_5 [style=invis, constraint=true];
  rel2_6 [label="", shape=point, width=0.01, height=0.01];
  rel2_5 -> rel2_6 [style=invis, constraint=true];
  rel1_1 -> pro1_1 [label="Outgoing() — deltas pending (1 s)", constraint=false, style=dashed, dir=forward, color="#5e35b1"];
  pro1_2 -> srv2_2 [label="PushDelta {site_id, node, inc/dec, seq}", constraint=false, style=solid, color="#c62828"];
  srv2_3 -> rel2_3 [label="Accept(fromNode, deltas)", constraint=false, style=dashed, dir=forward, color="#5e35b1"];
  rel2_4 -> rel2_4 [label="max-merge → valeur locale (total cumulé)", constraint=false, style=dashed, dir=forward, color="#2e7d32"];
  srv2_5 -> pro1_5 [label="ack {seq appliée, valeur}", constraint=false, style=dashed, color="#999"];
  pro1_6 -> rel1_6 [label="Confirm(ackSeq) — gc du pending", constraint=false, style=dashed, dir=forward, color="#5e35b1"];
  NOTE_2 [label="échec réseau ? repoussé au tick suivant
(jusqu'à ack) — les deltas ne sont jamais perdus
doublons/trous/réordonnancements inoffensifs (max)", shape=note, fontsize=8, style="rounded,filled", fillcolor="#fff3e0", color="#e65100"];
  { rank=same; rel1_1; pro1_1; srv2_1; rel2_1; }
  { rank=same; rel1_2; pro1_2; srv2_2; rel2_2; NOTE_2; }
  { rank=same; rel1_3; pro1_3; srv2_3; rel2_3; }
  { rank=same; rel1_4; pro1_4; srv2_4; rel2_4; }
  { rank=same; rel1_5; pro1_5; srv2_5; rel2_5; }
  { rank=same; rel1_6; pro1_6; srv2_6; rel2_6; }
}