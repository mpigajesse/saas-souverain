digraph crdt {
  rankdir=LR;
  graph [fontname="Helvetica", fontsize=11, fontcolor="#0b3d66",
         label="Relay delta-CRDT — fusion max par nœud émetteur (garantie AP)",
         labelloc=t, pad=0.4];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled",
         fillcolor="#eef4fa", color="#4a7196"];
  edge  [fontname="Helvetica", fontsize=9, color="#4a7196"];

  subgraph cluster_A {
    label="site A (atelier)";
    style=filled; fillcolor="#f7fafd"; color="#4a7196";
    addA  [label="Add(inc:7, dec:0)\nlocal total = 7", fillcolor="#fffde7", color="#b07c1a"];
    pendA [label="pending {A1: inc=7, seq=1}", fillcolor="#ede7f6", color="#5e35b1"];
    outA  [label="Outgoing()\ntout le total cumulé", fillcolor="#ede7f6", color="#5e35b1"];
    coA   [label="valeur locale A\n= Σ max-par-nœud", fillcolor="#e8f5e9", color="#2e7d32"];
    addA -> pendA -> outA -> coA;
  }

  subgraph cluster_B {
    label="site B (eshop)";
    style=filled; fillcolor="#f7fafd"; color="#4a7196";
    accB  [label="Accept(A1: inc=7)\nmax-merge\nvaleur locale = 7", fillcolor="#ede7f6", color="#5e35b1"];
    pendB [label="pending {B1: dec=3, seq=1}", fillcolor="#ede7f6", color="#5e35b1"];
    accB2 [label="Accept(B1: dec=3)\nvaleur locale = 7-3 = 4", fillcolor="#e8f5e9", color="#2e7d32"];
    accB -> accB2 -> pendB;
  }

  edge [color="#c62828", fontcolor="#c62828"];
  outA -> accB [label="PushDelta\n{node=A1, inc=7}\ntraceparent W3C"];
  pendB -> accB2 [constraint=false, style=dotted];
  edge [style=dotted, color="#4a7196", fontcolor="#4a7196"];
  accB2 -> outA [label="ack seq → Confirm(1)\n(gc du pending)"];

  note [label="delta = total CUMULÉ du nœud émetteur\n(pas un incrément) ⇒ doublons,\ntrous & réordonnancements inoffensifs",
        shape=note, fillcolor="#eeeeee", color="#555"];
}