digraph seq_write {
  rankdir=TB;
  graph [fontname="Helvetica", fontsize=11, fontcolor="#0b3d66", label="Séquence — chemin d'écriture (fencing lease) puis propagation CRDT", labelloc=t, pad=0.4, splines=polyline];
  node [fontname="Helvetica", fontsize=9, shape=point, width=0.02, height=0.02];
  edge [fontname="Helvetica", fontsize=8, color="#4a7196", arrowsize=0.7];
  H_cli [label="Client (A/B)", shape=box, style="rounded,filled", fillcolor="#ffffff", color="#2a4a66", fontname="Helvetica-Bold", fontsize=10];
  H_ora [label="Orchestrateur A (leader)", shape=box, style="rounded,filled", fillcolor="#ede7f6", color="#2a4a66", fontname="Helvetica-Bold", fontsize=10];
  H_etd [label="etcd « /amane/leader »", shape=box, style="rounded,filled", fillcolor="#fff8e1", color="#2a4a66", fontname="Helvetica-Bold", fontsize=10];
  H_orb [label="Orchestrateur B (pair)", shape=box, style="rounded,filled", fillcolor="#e3f2fd", color="#2a4a66", fontname="Helvetica-Bold", fontsize=10];
  cli_1 [label="", shape=point, width=0.01, height=0.01];
  H_cli -> cli_1 [style=invis, constraint=true];
  cli_2 [label="", shape=point, width=0.01, height=0.01];
  cli_1 -> cli_2 [style=invis, constraint=true];
  cli_3 [label="", shape=point, width=0.01, height=0.01];
  cli_2 -> cli_3 [style=invis, constraint=true];
  cli_4 [label="", shape=point, width=0.01, height=0.01];
  cli_3 -> cli_4 [style=invis, constraint=true];
  cli_5 [label="", shape=point, width=0.01, height=0.01];
  cli_4 -> cli_5 [style=invis, constraint=true];
  cli_6 [label="", shape=point, width=0.01, height=0.01];
  cli_5 -> cli_6 [style=invis, constraint=true];
  cli_7 [label="", shape=point, width=0.01, height=0.01];
  cli_6 -> cli_7 [style=invis, constraint=true];
  cli_8 [label="", shape=point, width=0.01, height=0.01];
  cli_7 -> cli_8 [style=invis, constraint=true];
  ora_1 [label="", shape=point, width=0.01, height=0.01];
  H_ora -> ora_1 [style=invis, constraint=true];
  ora_2 [label="", shape=point, width=0.01, height=0.01];
  ora_1 -> ora_2 [style=invis, constraint=true];
  ora_3 [label="", shape=point, width=0.01, height=0.01];
  ora_2 -> ora_3 [style=invis, constraint=true];
  ora_4 [label="", shape=point, width=0.01, height=0.01];
  ora_3 -> ora_4 [style=invis, constraint=true];
  ora_5 [label="", shape=point, width=0.01, height=0.01];
  ora_4 -> ora_5 [style=invis, constraint=true];
  ora_6 [label="", shape=point, width=0.01, height=0.01];
  ora_5 -> ora_6 [style=invis, constraint=true];
  ora_7 [label="", shape=point, width=0.01, height=0.01];
  ora_6 -> ora_7 [style=invis, constraint=true];
  ora_8 [label="", shape=point, width=0.01, height=0.01];
  ora_7 -> ora_8 [style=invis, constraint=true];
  etd_1 [label="", shape=point, width=0.01, height=0.01];
  H_etd -> etd_1 [style=invis, constraint=true];
  etd_2 [label="", shape=point, width=0.01, height=0.01];
  etd_1 -> etd_2 [style=invis, constraint=true];
  etd_3 [label="", shape=point, width=0.01, height=0.01];
  etd_2 -> etd_3 [style=invis, constraint=true];
  etd_4 [label="", shape=point, width=0.01, height=0.01];
  etd_3 -> etd_4 [style=invis, constraint=true];
  etd_5 [label="", shape=point, width=0.01, height=0.01];
  etd_4 -> etd_5 [style=invis, constraint=true];
  etd_6 [label="", shape=point, width=0.01, height=0.01];
  etd_5 -> etd_6 [style=invis, constraint=true];
  etd_7 [label="", shape=point, width=0.01, height=0.01];
  etd_6 -> etd_7 [style=invis, constraint=true];
  etd_8 [label="", shape=point, width=0.01, height=0.01];
  etd_7 -> etd_8 [style=invis, constraint=true];
  orb_1 [label="", shape=point, width=0.01, height=0.01];
  H_orb -> orb_1 [style=invis, constraint=true];
  orb_2 [label="", shape=point, width=0.01, height=0.01];
  orb_1 -> orb_2 [style=invis, constraint=true];
  orb_3 [label="", shape=point, width=0.01, height=0.01];
  orb_2 -> orb_3 [style=invis, constraint=true];
  orb_4 [label="", shape=point, width=0.01, height=0.01];
  orb_3 -> orb_4 [style=invis, constraint=true];
  orb_5 [label="", shape=point, width=0.01, height=0.01];
  orb_4 -> orb_5 [style=invis, constraint=true];
  orb_6 [label="", shape=point, width=0.01, height=0.01];
  orb_5 -> orb_6 [style=invis, constraint=true];
  orb_7 [label="", shape=point, width=0.01, height=0.01];
  orb_6 -> orb_7 [style=invis, constraint=true];
  orb_8 [label="", shape=point, width=0.01, height=0.01];
  orb_7 -> orb_8 [style=invis, constraint=true];
  cli_1 -> ora_1 [label="Write(journal_id, site_id, payload)", constraint=false, style=solid];
  ora_2 -> etd_2 [label="IsLeader() — lease détenue ?", constraint=false, style=dashed, dir=forward, color="#b07c1a"];
  etd_3 -> ora_3 [label="ok — leader (lease /amane/leader)", constraint=false, style=dashed, color="#999", arrowsize=0.7];
  ora_4 -> ora_4 [label="journal.Append(...) → ack", constraint=false, style=dashed, dir=forward, color="#2e7d32"];
  ora_5 -> ora_5 [label="Relay.Add(inc, dec) — delta + seq → pending", constraint=false, style=dashed, dir=forward, color="#5e35b1"];
  ora_6 -> orb_6 [label="PushDelta {totaux cumulés, traceparent}", constraint=false, style=solid, color="#c62828"];
  orb_7 -> ora_7 [label="ack = dernière seq appliquée", constraint=false, style=dashed, color="#999"];
  ora_8 -> ora_8 [label="Confirm(ackSeq) — gc du pending", constraint=false, style=dashed, dir=forward, color="#5e35b1"];
  NOTE_2 [label="si non-leader → codes.FailedPrecondition
« nœud non leader (fencing lease) »
avant TOUT accès journal", shape=note, fontsize=8, style="rounded,filled", fillcolor="#fff3e0", color="#e65100"];
  { rank=same; cli_1; ora_1; etd_1; orb_1; }
  { rank=same; cli_2; ora_2; etd_2; orb_2; NOTE_2; }
  { rank=same; cli_3; ora_3; etd_3; orb_3; }
  { rank=same; cli_4; ora_4; etd_4; orb_4; }
  { rank=same; cli_5; ora_5; etd_5; orb_5; }
  { rank=same; cli_6; ora_6; etd_6; orb_6; }
  { rank=same; cli_7; ora_7; etd_7; orb_7; }
  { rank=same; cli_8; ora_8; etd_8; orb_8; }
}