{
  "type_artefact": "docker",
  "image": "amane/app-egress@sha256:4552b10b2a738d629605f174449bb99d114b9f9eba84f0a0ecadf09da27480c0",
  "commande": [
    "/application"
  ],
  "port": 8080,
  "sante": "/sante",
  "variables": {
    "APP_ENV": "production"
  },
  "base_de_donnees": {
    "variables": {
      "DATABASE_URL": "postgres://{utilisateur}:{mot_de_passe}@{hote}:{port}/{base}?sslmode=disable"
    }
  },
  "hooks": {
    "pre_start": [
      [
        "/bin/sh",
        "/pre_start.sh"
      ]
    ]
  },
  "volumes": [
    {
      "nom": "migrations",
      "chemin": "/migrations"
    }
  ],
  "egress": {
    "allowed_domains": [
      "httpbin.org",
      "api.github.com"
    ],
    "proxy_via_node": true
  }
}
