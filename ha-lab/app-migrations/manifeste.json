{
  "type_artefact": "docker",
  "image": "amane/app-migrations@sha256:39aa4a0b15dbc2f0255697be689ad44bcde250a5cadd495761e3d3e100fde0a0",
  "commande": [
    "/application"
  ],
  "port": 8080,
  "sante": "/sante",
  "variables": {
    "APP_ENV": "production"
  },
  "base_de_donnees": {
    "variables": {
      "DATABASE_URL": "postgres://{utilisateur}:{mot_de_passe}@{hote}:{port}/{base}?sslmode=disable"
    }
  },
  "hooks": {
    "pre_start": [
      [
        "/bin/sh",
        "/pre_start.sh"
      ]
    ]
  },
  "volumes": [
    {
      "nom": "migrations",
      "chemin": "/migrations"
    }
  ]
}
