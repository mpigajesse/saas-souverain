# Relais EL BARAA CONSULT — variables d'environnement
# Copier ce fichier en .env et remplir les valeurs réelles
# NE JAMAIS COMMITTER .env dans git

# Secret partagé avec le portail éditeur (même valeur que son RELAY_SECRET).
# Le relais en dérive le jeton propre à chaque tenant (HMAC, ADR-011) : blobs
# et topologie d'un tenant ne s'ouvrent qu'avec son jeton. 32 caractères au
# moins ; `setup.sh` le génère s'il est vide (openssl rand -hex 32).
# Sans secret, le relais refuse de démarrer.
RELAY_SECRET=

# Laboratoire uniquement : 1 = relais ouvert, sans jeton (ignoré si
# RELAY_SECRET est défini).
RELAY_SANS_AUTHENTIFICATION=

# Interfaces réseau du serveur relais (affiché dans le portail éditeur)
# Format : iface:ip:role séparés par des virgules
# Renseigner avec les IPs réelles du serveur (voir : ip a)
# Exemple : ens33:<IP_WAN_EDITEUR>:editeur,ens34:<IP_LAN_RELAY>:interne
RELAY_NETWORKS=

# Port d'écoute (défaut 8080 — exposé sur 0.0.0.0)
# RELAY_PORT=8080
