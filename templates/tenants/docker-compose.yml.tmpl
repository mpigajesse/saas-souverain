{% autoescape off %}# -----------------------------------------------------------------------------
# AMANE — Pile PME, machine SERVEUR — {{ tenant.name }}
# Générée le : {{ generated_at }}
#
# DÉFINITION UNIQUE DE LA PILE (refonte V3, ADR-001, ADR-004, ADR-005). Les
# installeurs Windows et Linux la téléchargent depuis le portail ; Windows et
# Linux déploient donc rigoureusement les mêmes services.
#
#   amane-init          amorçage (une fois par démarrage) : rejoint ou crée le
#                       cluster etcd sur le réseau local de la PME
#   amane-etcd          consensus Raft : décide qui est primaire
#   amane-postgresql    PostgreSQL 17 piloté par Patroni (Spilo)
#   amane-orchestrateur détection de panne, secrets, rôle amane, HAProxy
#   amane-haproxy       adresse fixe qui mène toujours au primaire du moment
#   ss-node             nœud AMANE : lit son rôle dans Patroni, ne décide rien
#   pgadmin             consultation locale des données
#
# Les mots de passe sont générés par la première machine et transmis aux
# suivantes par etcd : ils ne quittent jamais le réseau de la PME et l'éditeur
# ne les connaît pas. Aucune image n'est référencée par tag : chacune est
# épinglée par digest.
#
# Seul paramétrage : le fichier « .env » déposé à côté par l'installeur.
#   NODE_IP             IP LAN de la machine, annoncée aux autres
#   NODE_HOSTNAME       nom de la machine (membre etcd et Patroni)
#   NODE_MODE           active = premier serveur (génère la DEK), passive sinon
#                       (ne décide plus du rôle PostgreSQL : Patroni le fait)
#   SAAS_URL / REGISTRATION_TOKEN / RELAY_URL / TENANT_ID / WEB_PORT
#   PGADMIN_EMAIL
# -----------------------------------------------------------------------------

networks:
  amane:
    driver: bridge
{% if application %}  # Réseau de l'application hébergée : INTERNE, sans aucune sortie vers
  # Internet (ADR-003, étape 4). Seuls le nœud (interface) et HAProxy (base)
  # y sont joignables : l'application ne peut rien envoyer à son éditeur.
  amane-application:
    driver: bridge
    internal: true
{% endif %}
services:
  amane-init:
    image: {{ images.orchestrateur }}
    container_name: amane-init
    # Root le temps de l'amorçage : il prépare les droits des volumes partagés.
    user: "0"
    restart: "no"
    networks: [amane]
    command:
      - init
      - -nom=${NODE_HOSTNAME}
      - -ip=${NODE_IP}
      - -portail=${SAAS_URL}
      - -jeton=${REGISTRATION_TOKEN}
      - -dossier-secrets=/amane/secrets
      - -dossier-haproxy=/amane/haproxy
{% if application.base %}      # Lanceur statique de l'application (identifiants de sa base, étape 3).
      - -copier-binaire=/amane/bin
{% endif %}    volumes:
      - etcd-data:/etcd-data
      - etcd-conf:/amane/etcd
      - secrets:/amane/secrets
      - haproxy:/amane/haproxy
{% if application.base %}      - amane-bin:/amane/bin
{% endif %}
  amane-etcd:
    image: {{ images.etcd }}
    container_name: amane-etcd
    restart: unless-stopped
    networks: [amane]
    # Configuration (ETCD_*) produite par l'amorçage.
    command: ["sh", "-c", ". /amane/etcd/etcd.env && exec etcd"]
    ports: ["2379:2379", "2380:2380"]
    volumes:
      - etcd-data:/etcd-data
      - etcd-conf:/amane/etcd
    healthcheck:
      test: ["CMD", "etcdctl", "endpoint", "health"]
      interval: 5s
      timeout: 3s
      retries: 60
    depends_on:
      amane-init: { condition: service_completed_successfully }

  amane-orchestrateur:
    image: {{ images.orchestrateur }}
    container_name: amane-orchestrateur
    restart: unless-stopped
    networks: [amane]
    command:
      - -etcd-endpoints=amane-etcd:2379
      - -supervisor
      - -decouvrir
      - -patroni-scope=amane
      - -secrets=/amane/secrets/postgresql.env
      - -haproxy-dossier=/amane/haproxy
      # Mode synchrone strict à partir de 3 serveurs (ADR-004, décision 2).
      - -synchrone-auto
{% if application.base %}      # Rôle, base et identifiants de l'application hébergée (étape 3).
      - -application-secrets=/amane/secrets/application.env
{% endif %}    environment:
      AMANE_NODE_ID: "${NODE_HOSTNAME}"
    volumes:
      - secrets:/amane/secrets
      - haproxy:/amane/haproxy
    depends_on:
      amane-etcd: { condition: service_healthy }

  amane-postgresql:
    image: {{ images.postgresql }}
    container_name: amane-postgresql
    # Spilo nomme le membre Patroni d'après le NOM D'HÔTE du conteneur (il
    # ignore PATRONI_NAME). Ce nom doit être celui de la machine : c'est par lui
    # que l'orchestrateur reconnaît son nœud local (AMANE_NODE_ID) et que la
    # garde anti-partition s'applique.
    hostname: "${NODE_HOSTNAME}"
    restart: unless-stopped
    networks: [amane]
    ports: ["5432:5432", "8008:8008"]
    # Mots de passe du cluster, écrits par l'orchestrateur local.
    command:
      - /bin/sh
      - -c
      - until [ -f /amane/secrets/postgresql.env ]; do sleep 1; done; . /amane/secrets/postgresql.env; exec /bin/sh /launch.sh init
    environment:
      SCOPE: amane
      PATRONI_NAME: "${NODE_HOSTNAME}"
      ETCD3_HOSTS: "amane-etcd:2379"
      PATRONI_RESTAPI_LISTEN: 0.0.0.0:8008
      PATRONI_POSTGRESQL_LISTEN: 0.0.0.0:5432
      # Adresses annoncées aux autres machines : l'IP LAN, pas celle du
      # conteneur (Spilo lit ces variables, et non les PATRONI_*).
      RESTAPI_CONNECT_ADDRESS: "${NODE_IP}:8008"
      PG_CONNECT_ADDRESS: "${NODE_IP}:5432"
      # Connexions non chiffrées admises sur le réseau PME ; chiffrement entre
      # machines : mesh WireGuard, étape 4 (ADR-004, décision 6).
      ALLOW_NOSSL: "true"
      SPILO_CONFIGURATION: |
        bootstrap:
          dcs:
            ttl: 20
            loop_wait: 2
            retry_timeout: 5
            synchronous_mode: true
            synchronous_mode_strict: false
            postgresql:
              parameters:
                synchronous_commit: "on"
                max_wal_senders: 5
                max_slot_wal_keep_size: 1024MB
    volumes:
      - pg-data:/home/postgres/pgdata
      - secrets:/amane/secrets:ro
    depends_on:
      amane-etcd: { condition: service_healthy }

  amane-haproxy:
    image: {{ images.haproxy }}
    container_name: amane-haproxy
    restart: unless-stopped
    networks: [amane{% if application %}, amane-application{% endif %}]
    # Configuration écrite et rechargée par l'orchestrateur ; port 5000 joint
    # par les conteneurs de la machine uniquement (non publié).
    command:
      - sh
      - -c
      - until [ -f /amane/haproxy/haproxy.cfg ]; do sleep 1; done; exec haproxy -W -db -S /amane/haproxy/master.sock,mode,666 -f /amane/haproxy/haproxy.cfg
    volumes:
      - haproxy:/amane/haproxy
    depends_on: [amane-orchestrateur]

  ss-node:
    image: {{ images.noeud }}
    container_name: ss-node
    restart: unless-stopped
    networks: [amane{% if application %}, amane-application{% endif %}]
    ports:
      - "${WEB_PORT:-9001}:${WEB_PORT:-9001}"
    # Données par HAProxy : le nœud écrit toujours sur le primaire du moment,
    # quelle que soit sa machine. Son rôle, il le lit dans Patroni
    # (PATRONI_URL) : garde de quorum en lecture et fencing par la timeline
    # (refonte V3, étape 2c). Il ne décide d'aucune bascule.
    entrypoint:
      - /bin/sh
      - -c
      - until [ -f /amane/secrets/postgresql.env ]; do sleep 1; done; . /amane/secrets/postgresql.env; export PG_URL="postgres://amane:$${AMANE_PG_PASSWORD}@amane-haproxy:5000/amane"; exec /entrypoint.sh run --mode "$${NODE_MODE:-passive}"
    environment:
      SS_NODE_DIR: /data
      WEB_PORT: "${WEB_PORT:-9001}"
      TENANT_ID: "${TENANT_ID:-{{ tenant.id }}}"
      REGISTRATION_TOKEN: "${REGISTRATION_TOKEN}"
      RELAY_URL: "${RELAY_URL:-{{ relay_url }}}"
      SAAS_URL: "${SAAS_URL}"
      NODE_ADDR: "${NODE_IP}:${WEB_PORT:-9001}"
      # active = premier serveur : génère la DEK au premier démarrage.
      NODE_MODE: "${NODE_MODE:-passive}"
      PATRONI_URL: http://amane-postgresql:8008
{% if application %}      # Application hébergée : servie à la racine du port web, telle que son
      # éditeur l'a conçue ; console du nœud sous /amane (étape 3, ADR-007).
      AMANE_APP_URL: http://amane-application:{{ application.port }}
      AMANE_APP_SANTE: "{{ application.sante }}"
{% endif %}      HOSTNAME: "${NODE_HOSTNAME}"
      # Chiffrement du disque de la machine, constaté par l'installeur
      # (oui / non / inconnu) et signalé au portail (ADR-008).
      CHIFFREMENT_DISQUE: "${CHIFFREMENT_DISQUE:-inconnu}"
      RUST_LOG: info
    volumes:
      - node-data:/data
      - secrets:/amane/secrets:ro
    depends_on: [amane-postgresql, amane-haproxy]

{% if application %}  # Application externe hébergée (étape 3, ADR-007) : image de son éditeur,
  # inchangée, épinglée par digest. Sa base et ses identifiants sont fournis
  # par AMANE ; elle la joint par HAProxy, donc toujours sur le primaire.
  amane-application:
    image: {{ application.image }}
    container_name: amane-application
    restart: unless-stopped
    networks: [amane-application]
{% if application.base %}    # Point d'entrée : le lanceur AMANE compose les variables de la base
    # (manifeste) puis exécute la commande d'origine de l'image.
    entrypoint: ["/amane/bin/orchestrator", "lancer", "-secrets=/amane/secrets/application.env", "--"]
    command: {{ application.commande }}
{% endif %}{% if application.environnement %}    environment:
{% for nom, valeur in application.environnement %}      {{ nom }}: {{ valeur }}
{% endfor %}{% endif %}    volumes:
{% if application.base %}      - amane-bin:/amane/bin:ro
      - secrets:/amane/secrets:ro
{% endif %}{% for v in application.volumes %}      - {{ v.cle }}:{{ v.chemin }}
{% endfor %}{% if not application.base and not application.volumes %}      []
{% endif %}    depends_on: [amane-orchestrateur, amane-haproxy]

{% endif %}  pgadmin:
    image: {{ images.pgadmin }}
    container_name: pgadmin
    restart: unless-stopped
    networks: [amane]
    ports: ["5050:80"]
    entrypoint:
      - /bin/sh
      - -c
      - until [ -f /amane/secrets/postgresql.env ]; do sleep 1; done; . /amane/secrets/postgresql.env; exec /entrypoint.sh
    environment:
      PGADMIN_DEFAULT_EMAIL: "${PGADMIN_EMAIL:-admin@pme-amane.com}"
      PGADMIN_CONFIG_SERVER_MODE: "False"
      PGADMIN_CONFIG_MASTER_PASSWORD_REQUIRED: "False"
    volumes:
      - pgadmin-data:/var/lib/pgadmin
      - secrets:/amane/secrets:ro
    depends_on: [amane-haproxy]

volumes:
  etcd-data:
  etcd-conf:
  secrets:
  haproxy:
  pg-data:
  node-data:
  pgadmin-data:
{% if application.base %}  amane-bin:
{% endif %}{% for v in application.volumes %}  {{ v.cle }}:
{% endfor %}{% endautoescape %}
