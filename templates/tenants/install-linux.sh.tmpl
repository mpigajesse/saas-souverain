{% autoescape off %}#!/bin/bash
# EL BARAA CONSULT — Installateur PME (Linux) — machine {{ type_machine|upper }}
# Généré le : {{ generated_at }}
# Tenant    : {{ tenant.name }}
#
# Cet installeur et son homologue Windows (.bat) déroulent EXACTEMENT les mêmes
# étapes et déploient la même pile, téléchargée depuis le portail éditeur
# (`/api/tenants/pme/compose/`), unique définition de la pile.
#
# Refonte V3 (ADR-005) : plus aucune question sur le primaire ni aucun mot de
# passe calculé ici. Les machines se coordonnent seules sur le réseau local
# (etcd + Patroni) et les mots de passe sont générés par la première machine,
# sans jamais passer par le portail.
set -e

# ── Variables injectées par le portail éditeur ────────────────────────────────
TYPE_MACHINE="{{ type_machine }}"
REGISTRATION_TOKEN="{{ tenant.registration_token }}"
RELAY_URL="{{ relay_url }}"
SAAS_URL="http://{{ saas_host }}:{{ saas_port }}"
REGISTRY_HOST="{{ registry_host }}"
INSTALL_DIR="/opt/amane-pme"
ANCIEN_DIR="/opt/elbaraa-pme"

# Port unique de l'interface web du nœud — même valeur sur Windows et Linux,
# c'est aussi le port annoncé au portail dans NODE_ADDR.
WEB_PORT=9001

echo ""
echo "===================================================="
echo "  EL BARAA CONSULT — Installation logiciel PME"
echo "  Tenant : {{ tenant.name }}"
echo "  Machine : ${TYPE_MACHINE}"
echo "===================================================="
echo ""

# ── 0. Vérification root ──────────────────────────────────────────────────────
if [ "$EUID" -ne 0 ]; then
    echo "ERREUR : Exécutez avec sudo : sudo bash installer-pme.sh"
    exit 1
fi

mkdir -p "${INSTALL_DIR}"

# ── 1. Adresse réseau et nom de la machine ───────────────────────────────────
echo "[1/8] Détection de l'adresse réseau..."
MY_IP=$(ip -4 addr show | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | grep -v '^127\.' | grep -v '^169\.254\.' | while read -r ip; do
    prefix=$(echo "$ip" | cut -d. -f1-3)
    saas_prefix=$(echo "{{ saas_host }}" | cut -d. -f1-3)
    if [ "$prefix" = "$saas_prefix" ]; then echo "$ip"; break; fi
done)
[ -z "$MY_IP" ] && MY_IP=$(ip -4 addr show | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | grep -v '^127\.' | grep -v '^169\.254\.' | head -1)
if [ -z "$MY_IP" ]; then
    echo "ERREUR : aucune adresse réseau exploitable. Les autres machines doivent"
    echo "pouvoir joindre celle-ci sur le réseau local."
    exit 1
fi
# Nom de la machine = nom du membre etcd et Patroni : lettres, chiffres, . _ -
MY_HOSTNAME=$(hostname 2>/dev/null | tr -c 'A-Za-z0-9_.\n-' '-' | sed 's/^[^A-Za-z0-9]*//' | cut -c1-63)
[ -z "$MY_HOSTNAME" ] && MY_HOSTNAME="pme-$(echo "$MY_IP" | tr . -)"
echo "       IP : $MY_IP   Nom : $MY_HOSTNAME"

# ── 2. Docker ────────────────────────────────────────────────────────────────
echo "[2/8] Vérification de Docker..."
if ! command -v docker &>/dev/null; then
    echo "       Docker absent — installation automatique..."
    curl -fsSL https://get.docker.com | sh
    systemctl enable --now docker
    echo "       Docker installé."
else
    echo "       Docker déjà présent."
fi

# ── 3. Autoriser le registre local de l'éditeur (LAN — sans TLS) ─────────────
# Sans cela, « docker pull {{ registry_host }}/... » échoue avec « server gave
# HTTP response to HTTPS client » : Docker exige du TLS sur tout registre qui
# n'est pas explicitement déclaré comme non sécurisé.
echo "[3/8] Autorisation du registre éditeur ${REGISTRY_HOST}..."
DAEMON_JSON="/etc/docker/daemon.json"
if [ -f "$DAEMON_JSON" ]; then
    # Fusion idempotente : relancer l'installeur ne doit pas empiler la même
    # entrée plusieurs fois dans insecure-registries.
    python3 -c "
import json
with open('$DAEMON_JSON') as f: d=json.load(f)
liste = d.setdefault('insecure-registries',[])
if '$REGISTRY_HOST' not in liste:
    liste.append('$REGISTRY_HOST')
    with open('$DAEMON_JSON','w') as f: json.dump(d,f,indent=2)
" 2>/dev/null || true
else
    printf '{"insecure-registries":["%s"]}\n' "$REGISTRY_HOST" > "$DAEMON_JSON"
fi
systemctl restart docker 2>/dev/null || true

# ── 4. Ancienne pile V2 ──────────────────────────────────────────────────────
# Arrêtée pour libérer ports et noms de conteneurs ; ses volumes sont CONSERVÉS
# (données V2 récupérables à la main), la nouvelle pile a les siens.
echo "[4/8] Recherche d'une ancienne installation..."
if [ -f "${ANCIEN_DIR}/docker-compose.yml" ]; then
    echo "       Ancienne pile trouvée dans ${ANCIEN_DIR} : arrêt (volumes conservés)."
    (cd "${ANCIEN_DIR}" && docker compose down) || true
    systemctl disable elbaraa-pme.service 2>/dev/null || true
else
    echo "       Aucune."
fi

# ── 5. Premier serveur du cluster ? ──────────────────────────────────────────
# NODE_MODE ne décide plus du rôle PostgreSQL (Patroni le fait) : le premier
# serveur génère la DEK au premier démarrage du nœud. Les témoins ne comptent pas.
NODE_MODE="passive"
if [ "$TYPE_MACHINE" = "serveur" ]; then
    echo "[5/8] Recherche des serveurs déjà installés..."
    NB_SERVEURS=$(curl -sf "${SAAS_URL}/api/devices/cluster-status/?token=${REGISTRATION_TOKEN}" 2>/dev/null \
        | python3 -c "import json,sys; print(sum(1 for n in json.load(sys.stdin).get('active_nodes',[]) if n.get('node_kind','serveur')=='serveur'))" 2>/dev/null \
        || echo "0")
    if [ "$NB_SERVEURS" = "0" ]; then
        NODE_MODE="active"
        echo "       Premier serveur du cluster."
    else
        echo "       ${NB_SERVEURS} serveur(s) déjà installé(s) : cette machine rejoindra le cluster."
    fi
else
    echo "[5/8] Témoin : aucun nœud AMANE sur cette machine."
fi

# ── 6. Fichier .env et pile ──────────────────────────────────────────────────
echo "[6/8] Écriture du .env et téléchargement de la pile..."
cat > "${INSTALL_DIR}/.env" << ENV_EOF
NODE_IP=${MY_IP}
NODE_HOSTNAME=${MY_HOSTNAME}
NODE_MODE=${NODE_MODE}
WEB_PORT=${WEB_PORT}
SAAS_URL=${SAAS_URL}
RELAY_URL=${RELAY_URL}
REGISTRATION_TOKEN=${REGISTRATION_TOKEN}
TENANT_ID={{ tenant.id }}
PGADMIN_EMAIL=admin@pme{{ tenant.name|slugify }}.com
ENV_EOF
if ! curl -fsSL -o "${INSTALL_DIR}/docker-compose.yml" \
    "${SAAS_URL}/api/tenants/pme/compose/?token=${REGISTRATION_TOKEN}&type=${TYPE_MACHINE}"; then
    echo "ERREUR : impossible de télécharger la pile depuis ${SAAS_URL}."
    echo "Vérifiez que le portail est joignable et que l'éditeur a publié les images."
    exit 1
fi

# ── 7. Pare-feu ──────────────────────────────────────────────────────────────
# etcd 2379/2380 sur toutes les machines ; sur un serveur, PostgreSQL 5432,
# API Patroni 8008, nœud et pgAdmin en plus.
if [ "$TYPE_MACHINE" = "serveur" ]; then
    PORTS="2379 2380 5432 8008 ${WEB_PORT} 5050"
else
    PORTS="2379 2380"
fi
echo "[7/8] Ouverture du pare-feu (${PORTS})..."
for port in $PORTS; do
    if command -v ufw &>/dev/null && ufw status 2>/dev/null | grep -q "active"; then
        ufw allow "${port}/tcp" comment "AMANE-PME" >/dev/null 2>&1 || true
    elif command -v firewall-cmd &>/dev/null; then
        firewall-cmd --permanent --add-port="${port}/tcp" >/dev/null 2>&1 || true
    fi
done
command -v firewall-cmd &>/dev/null && firewall-cmd --reload >/dev/null 2>&1 || true

# ── 8. Démarrage + démarrage automatique au boot ─────────────────────────────
echo "[8/8] Téléchargement des images et démarrage..."
cd "${INSTALL_DIR}"
if ! docker compose pull; then
    echo "ERREUR : images indisponibles dans le registre ${REGISTRY_HOST}."
    exit 1
fi
docker compose up -d

cat > /etc/systemd/system/amane-pme.service << 'SERVICE_EOF'
[Unit]
Description=AMANE PME
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/amane-pme
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
SERVICE_EOF
systemctl daemon-reload
systemctl enable amane-pme.service

echo ""
echo "===================================================="
echo "  Installation terminée ! ({{ tenant.name }} — ${TYPE_MACHINE} ${MY_HOSTNAME})"
echo ""
if [ "$TYPE_MACHINE" = "serveur" ]; then
    # Les mots de passe sont générés sur le réseau de la PME : on attend que
    # l'orchestrateur local les ait obtenus pour afficher celui de pgAdmin.
    PGADMIN_PASSWORD=""
    for i in $(seq 1 60); do
        PGADMIN_PASSWORD=$(docker exec amane-orchestrateur sh -c '. /amane/secrets/postgresql.env 2>/dev/null && printf %s "$PGADMIN_DEFAULT_PASSWORD"' 2>/dev/null || true)
        [ -n "$PGADMIN_PASSWORD" ] && break
        sleep 5
    done
    echo "  Interface   : http://${MY_IP}:${WEB_PORT}"
    echo "  pgAdmin     : http://${MY_IP}:5050"
    echo "    Login pgAdmin : admin@pme{{ tenant.name|slugify }}.com"
    if [ -n "$PGADMIN_PASSWORD" ]; then
        echo "    Mot de passe  : ${PGADMIN_PASSWORD}"
    else
        echo "    Mot de passe  : pas encore disponible (cluster en cours de formation)."
    fi
    echo "    (il n'est connu que des machines de la PME ; pour le relire :"
    echo "     sudo docker exec amane-orchestrateur sh -c '. /amane/secrets/postgresql.env; echo \$PGADMIN_DEFAULT_PASSWORD')"
else
    echo "  Témoin etcd actif : il donne au cluster sa majorité quand l'un"
    echo "  des deux serveurs est indisponible. Laissez cette machine allumée."
fi
echo ""
echo "  Espace PME : ${SAAS_URL}/mon-espace"
echo "===================================================="
{% endautoescape %}
