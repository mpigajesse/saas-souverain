{% autoescape off %}@echo off
chcp 65001 >nul 2>&1
setlocal EnableExtensions EnableDelayedExpansion
title EL BARAA CONSULT - Installation PME

:: ===========================================================================
:: EL BARAA CONSULT - Installateur PME (Windows) - machine {{ type_machine }}
:: Genere le : {{ generated_at_ascii }}
::
:: Cet installeur et son homologue Linux (.sh) deroulent EXACTEMENT les memes
:: etapes et deploient la meme pile, telechargee depuis le portail editeur
:: (/api/tenants/pme/compose/), unique definition de la pile.
::
:: Refonte V3 (ADR-005) : plus aucune question sur le primaire ni aucun mot
:: de passe calcule ici. Les machines se coordonnent seules sur le reseau
:: local (etcd + Patroni) et les mots de passe sont generes par la premiere
:: machine, sans jamais passer par le portail.
::
:: CONTRAINTES DE CE FICHIER - non negociables :
::  1. ASCII PUR. cmd lit un .bat par decalage d'octets ; un seul caractere
::     multi-octets (accent, guillemet typographique, tiret cadratin), meme
::     dans un commentaire, lui fait perdre sa position apres un goto et le
::     script execute des fragments tronques, ou se ferme sans message.
::  2. AUCUN label (:NOM) a l'interieur d'un bloc entre parentheses : cmd
::     corrompt le flux silencieusement. On enchaine par goto.
::  3. Dans un for /f qui appelle powershell entre backticks, le tube s'ecrit
::     " | " NU, jamais " ^| " : cmd n'applique pas l'echappement par caret a
::     l'interieur des guillemets, le caret arrivait donc tel quel a PowerShell
::     qui refusait d'analyser la commande - en silence, la variable restait
::     vide.
::  4. Attention aux % dans les commandes PowerShell embarquees (pas d'alias %
::     pour ForEach-Object), et a !VAR! (EnableDelayedExpansion est actif).
:: ===========================================================================

echo.
echo ====================================================
echo  EL BARAA CONSULT - Installation du logiciel PME
echo  Tenant  : {{ tenant_nom_ascii }}
echo  Machine : {{ type_machine }}
echo ====================================================
echo.

:: Verification droits administrateur
net session >nul 2>&1
if %ERRORLEVEL% NEQ 0 goto NOT_ADMIN
goto IS_ADMIN

:NOT_ADMIN
echo ERREUR : Executer en tant qu administrateur.
echo Clic droit - Executer en tant qu administrateur
pause
exit /b 1

:IS_ADMIN

set "TYPE_MACHINE={{ type_machine }}"
set "INSTALL_DIR=%PROGRAMDATA%\Amane\PME"
set "ANCIEN_DIR=%PROGRAMDATA%\ElBaraaConsult\PME"
set "SAAS_URL=http://{{ saas_host }}:{{ saas_port }}"
set "RELAY_URL={{ relay_url }}"
set "REGISTRATION_TOKEN={{ tenant.registration_token }}"
set "REGISTRY_HOST={{ registry_host }}"
:: Port unique de l'interface web du noeud - meme valeur que sur Linux, et
:: meme port que celui annonce au portail dans NODE_ADDR.
set "WEB_PORT=9001"
mkdir "%INSTALL_DIR%" >nul 2>&1

:: ---------------------------------------------------------------------------
:: [1/8] Adresse reseau et nom de la machine
:: ---------------------------------------------------------------------------
echo [1/8] Detection de l'adresse reseau...
set "NODE_IP="
for /f "usebackq delims=" %%A in (`powershell -NoProfile -ExecutionPolicy Bypass -Command "(Get-NetIPAddress -AddressFamily IPv4 | Where-Object { $_.IPAddress -notlike '127.*' -and $_.IPAddress -notlike '169.*' } | Sort-Object PrefixLength | Select-Object -Last 1).IPAddress"`) do set "NODE_IP=%%A"
if "!NODE_IP!"=="" goto IP_ERROR
:: Nom de la machine = nom du membre etcd et Patroni : lettres, chiffres, . _ -
set "NODE_HOSTNAME="
for /f "usebackq delims=" %%A in (`powershell -NoProfile -ExecutionPolicy Bypass -Command "$n=($env:COMPUTERNAME -replace '[^A-Za-z0-9_.-]','-').TrimStart('-_.'); if ($n.Length -gt 63) { $n=$n.Substring(0,63) }; $n"`) do set "NODE_HOSTNAME=%%A"
if "!NODE_HOSTNAME!"=="" set "NODE_HOSTNAME=pme-windows"
echo        IP : !NODE_IP!   Nom : !NODE_HOSTNAME!
:: Chiffrement du disque (ADR-008) : les donnees de la PME sont au repos sur le
:: disque systeme (Docker Desktop) ; AMANE delegue leur chiffrement a BitLocker
:: et le verifie ici.
set "CHIFFREMENT_DISQUE=inconnu"
for /f "usebackq delims=" %%A in (`powershell -NoProfile -ExecutionPolicy Bypass -Command "$v=Get-BitLockerVolume -MountPoint $env:SystemDrive -ErrorAction SilentlyContinue; if ($v) { if ([string]$v.ProtectionStatus -eq 'On') { 'oui' } else { 'non' } } else { 'inconnu' }"`) do set "CHIFFREMENT_DISQUE=%%A"
echo        Disque chiffre : !CHIFFREMENT_DISQUE!
goto IP_READY

:IP_ERROR
echo ERREUR : aucune adresse reseau exploitable. Les autres machines doivent
echo pouvoir joindre celle-ci sur le reseau local.
pause
exit /b 1

:IP_READY

:: ---------------------------------------------------------------------------
:: [2/8] Docker
:: ---------------------------------------------------------------------------
echo [2/8] Verification de Docker...
docker info >nul 2>&1
if %ERRORLEVEL% EQU 0 goto DOCKER_READY

echo        Docker non detecte, telechargement...
set "DOCKER_OUT=%TEMP%\DockerSetup.exe"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$u='https://desktop.docker.com/win/main/amd64/Docker Desktop Installer.exe'; Invoke-WebRequest -Uri $u -OutFile '%DOCKER_OUT%' -UseBasicParsing"
if %ERRORLEVEL% NEQ 0 goto DOCKER_DL_ERROR

echo        Installation Docker Desktop...
start /wait "" "%DOCKER_OUT%" install --quiet --accept-license
del "%DOCKER_OUT%" >nul 2>&1

echo        Demarrage Docker Desktop...
start "" "C:\Program Files\Docker\Docker\Docker Desktop.exe"
echo        Attente Docker...

:WAIT_DOCKER
timeout /t 5 /nobreak >nul
docker info >nul 2>&1
if %ERRORLEVEL% NEQ 0 goto WAIT_DOCKER
goto DOCKER_READY

:DOCKER_DL_ERROR
echo ERREUR : Telechargement Docker impossible. Verifiez la connexion Internet.
pause
exit /b 1

:DOCKER_READY
echo        Docker operationnel.

:: ---------------------------------------------------------------------------
:: [3/8] Autoriser le registre de l'editeur (LAN, sans TLS)
:: Sans cela, " docker pull {{ registry_host }}/... " echoue avec
:: " server gave HTTP response to HTTPS client " : Docker exige du TLS sur tout
:: registre qui n'est pas explicitement declare comme non securise.
:: ---------------------------------------------------------------------------
echo [3/8] Autorisation du registre editeur {{ registry_host }}...
set "REG_STATE="
for /f "usebackq delims=" %%S in (`powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='SilentlyContinue'; $path=Join-Path $env:ProgramData 'Docker\config\daemon.json'; $reg='{{ registry_host }}'; $obj=$null; if (Test-Path $path) { try { $obj = Get-Content $path -Raw -Encoding UTF8 | ConvertFrom-Json } catch { $obj=$null } }; $liste=@(); if ($obj -and ($obj.PSObject.Properties.Name -contains 'insecure-registries')) { $liste=@($obj.'insecure-registries') }; if ($liste -contains $reg) { 'DEJA' } else { $liste+=$reg; if (-not $obj) { $obj=New-Object PSObject }; $obj | Add-Member -NotePropertyName 'insecure-registries' -NotePropertyValue $liste -Force; New-Item -ItemType Directory -Force -Path (Split-Path $path) | Out-Null; $obj | ConvertTo-Json -Depth 10 | Set-Content -Path $path -Encoding utf8; 'MODIFIE' }"`) do set "REG_STATE=%%S"

if /I "!REG_STATE!"=="MODIFIE" goto REGISTRY_RESTART
echo        Registre deja autorise.
goto REGISTRY_READY

:REGISTRY_RESTART
echo        daemon.json mis a jour, redemarrage de Docker...
powershell -NoProfile -ExecutionPolicy Bypass -Command "Restart-Service com.docker.service -Force -ErrorAction SilentlyContinue" >nul 2>&1
echo        Attente du redemarrage de Docker...
set /a REG_WAIT=0

:WAIT_DOCKER_REG
timeout /t 5 /nobreak >nul
set /a REG_WAIT+=5
docker info >nul 2>&1
if !ERRORLEVEL! EQU 0 goto REGISTRY_READY
if !REG_WAIT! LSS 120 goto WAIT_DOCKER_REG
echo        AVERTISSEMENT : Docker n a pas redemarre tout seul.
echo        Redemarrez Docker Desktop manuellement puis relancez cet installeur.
pause
exit /b 1

:REGISTRY_READY

:: ---------------------------------------------------------------------------
:: [4/8] Ancienne pile V2 : arretee pour liberer ports et noms de conteneurs.
:: Ses volumes sont CONSERVES (donnees V2 recuperables a la main) ; la
:: nouvelle pile a les siens.
:: ---------------------------------------------------------------------------
echo [4/8] Recherche d'une ancienne installation...
if not exist "%ANCIEN_DIR%\docker-compose.yml" goto ANCIEN_ABSENT
echo        Ancienne pile trouvee : arret (volumes conserves).
docker compose -f "%ANCIEN_DIR%\docker-compose.yml" --project-directory "%ANCIEN_DIR%" down >nul 2>&1
schtasks /delete /tn "ElBaraaConsultPME" /f >nul 2>&1
goto ANCIEN_READY

:ANCIEN_ABSENT
echo        Aucune.

:ANCIEN_READY

:: ---------------------------------------------------------------------------
:: [5/8] Premier serveur du cluster ?
:: NODE_MODE ne decide plus du role PostgreSQL (Patroni le fait) : le premier
:: serveur genere la DEK au premier demarrage du noeud. Les temoins ne
:: comptent pas.
:: ---------------------------------------------------------------------------
set "NODE_MODE=passive"
if /I not "!TYPE_MACHINE!"=="serveur" goto MODE_TEMOIN
echo [5/8] Recherche des serveurs deja installes...
set "NB_SERVEURS=0"
for /f "usebackq delims=" %%A in (`powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='SilentlyContinue'; $r=$null; try { $r = Invoke-RestMethod -Uri '!SAAS_URL!/api/devices/cluster-status/?token=!REGISTRATION_TOKEN!' -UseBasicParsing -TimeoutSec 10 } catch { $r=$null }; $n=0; if ($r) { foreach ($x in @($r.active_nodes)) { if ((-not $x.node_kind) -or ($x.node_kind -eq 'serveur')) { $n=$n+1 } } }; $n"`) do set "NB_SERVEURS=%%A"
if "!NB_SERVEURS!"=="" set "NB_SERVEURS=0"
if not "!NB_SERVEURS!"=="0" goto MODE_SUIVANT
set "NODE_MODE=active"
echo        Premier serveur du cluster.
goto MODE_READY

:MODE_SUIVANT
echo        !NB_SERVEURS! serveur(s) deja installe(s) : cette machine rejoindra le cluster.
goto MODE_READY

:MODE_TEMOIN
echo [5/8] Temoin : aucun noeud AMANE sur cette machine.

:MODE_READY

:: ---------------------------------------------------------------------------
:: [6/8] Fichier .env et pile
:: ---------------------------------------------------------------------------
echo [6/8] Ecriture du .env et telechargement de la pile...
(
echo NODE_IP=!NODE_IP!
echo NODE_HOSTNAME=!NODE_HOSTNAME!
echo NODE_MODE=!NODE_MODE!
echo WEB_PORT=!WEB_PORT!
echo SAAS_URL=!SAAS_URL!
echo RELAY_URL=!RELAY_URL!
echo REGISTRATION_TOKEN=!REGISTRATION_TOKEN!
echo TENANT_ID={{ tenant.id }}
echo PGADMIN_EMAIL=admin@pme{{ tenant.name|slugify }}.com
echo CHIFFREMENT_DISQUE=!CHIFFREMENT_DISQUE!
) > "%INSTALL_DIR%\.env"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; Invoke-WebRequest -Uri '!SAAS_URL!/api/tenants/pme/compose/?token=!REGISTRATION_TOKEN!&type=!TYPE_MACHINE!' -OutFile '%INSTALL_DIR%\docker-compose.yml' -UseBasicParsing"
if !ERRORLEVEL! NEQ 0 goto COMPOSE_ERROR
echo        Pile recuperee.
goto COMPOSE_READY

:COMPOSE_ERROR
echo ERREUR : impossible de telecharger la pile depuis !SAAS_URL!.
echo Verifiez que le portail est joignable et que l'editeur a publie les images.
pause
exit /b 1

:COMPOSE_READY

:: ---------------------------------------------------------------------------
:: [7/8] Pare-feu : etcd 2379/2380 sur toutes les machines ; sur un serveur,
:: PostgreSQL 5432, API Patroni 8008, noeud et pgAdmin en plus.
:: ---------------------------------------------------------------------------
echo [7/8] Ouverture du pare-feu...
netsh advfirewall firewall add rule name="Amane-PME-etcd" protocol=TCP dir=in localport=2379,2380 action=allow >nul 2>&1
if /I not "!TYPE_MACHINE!"=="serveur" goto PAREFEU_READY
netsh advfirewall firewall add rule name="Amane-PME-PostgreSQL" protocol=TCP dir=in localport=5432,8008 action=allow >nul 2>&1
netsh advfirewall firewall add rule name="Amane-PME-Noeud" protocol=TCP dir=in localport=!WEB_PORT!,5050 action=allow >nul 2>&1

:PAREFEU_READY

:: ---------------------------------------------------------------------------
:: [8/8] Demarrage + demarrage automatique au boot
:: ---------------------------------------------------------------------------
echo [8/8] Telechargement des images et demarrage...
cd /d "%INSTALL_DIR%"
docker compose pull
if !ERRORLEVEL! NEQ 0 goto PULL_ERROR
docker compose up -d
if !ERRORLEVEL! NEQ 0 goto START_ERROR
echo        Logiciel demarre.
goto START_OK

:PULL_ERROR
echo ERREUR : images indisponibles dans le registre !REGISTRY_HOST!.
pause
exit /b 1

:START_ERROR
echo ERREUR : Demarrage echoue. Docker Desktop doit etre lance.
pause
exit /b 1

:START_OK
echo        Demarrage automatique au boot...
schtasks /create /tn "AmanePME" /tr "docker compose -f \"%INSTALL_DIR%\docker-compose.yml\" --project-directory \"%INSTALL_DIR%\" up -d" /sc onstart /ru SYSTEM /f >nul 2>&1
echo        Configure.

echo.
echo ====================================================
echo  Installation terminee ! ({{ tenant_nom_ascii }} - !TYPE_MACHINE! !NODE_HOSTNAME!)
echo.
if /I not "!TYPE_MACHINE!"=="serveur" goto FIN_TEMOIN

:: Les mots de passe sont generes sur le reseau de la PME : on attend que
:: l'orchestrateur local les ait obtenus pour afficher celui de pgAdmin.
set "PGADMIN_PASSWORD="
set /a ATTENTE=0

:WAIT_SECRETS
for /f "usebackq delims=" %%P in (`docker exec amane-orchestrateur sh -c ". /amane/secrets/postgresql.env 2>/dev/null && printf %%s $PGADMIN_DEFAULT_PASSWORD" 2^>nul`) do set "PGADMIN_PASSWORD=%%P"
if not "!PGADMIN_PASSWORD!"=="" goto SECRETS_READY
set /a ATTENTE+=5
if !ATTENTE! GEQ 300 goto SECRETS_READY
timeout /t 5 /nobreak >nul
goto WAIT_SECRETS

:SECRETS_READY
echo  Interface   : http://!NODE_IP!:!WEB_PORT!
echo  pgAdmin     : http://!NODE_IP!:5050
echo    Login pgAdmin : admin@pme{{ tenant.name|slugify }}.com
if "!PGADMIN_PASSWORD!"=="" echo    Mot de passe  : pas encore disponible, cluster en cours de formation.
if not "!PGADMIN_PASSWORD!"=="" echo    Mot de passe  : !PGADMIN_PASSWORD!
echo    (connu des seules machines de la PME ; pour le relire :
echo     docker exec amane-orchestrateur sh -c ". /amane/secrets/postgresql.env; echo $PGADMIN_DEFAULT_PASSWORD")
goto FIN

:FIN_TEMOIN
echo  Temoin etcd actif : il donne au cluster sa majorite quand l'un
echo  des deux serveurs est indisponible. Laissez cette machine allumee.

:FIN
if /I "!CHIFFREMENT_DISQUE!"=="oui" goto FIN_CHIFFRE
echo.
echo  ATTENTION : le disque de cette machine n'est pas chiffre, ou n'a pas pu
echo  etre verifie. Les donnees de la PME y sont stockees en clair au repos :
echo  activez BitLocker pour tenir la promesse AMANE.

:FIN_CHIFFRE
echo.
echo  Espace PME : !SAAS_URL!/mon-espace
echo ====================================================
echo.
pause
{% endautoescape %}
