# Secrets du banc de test amane (A-00, A-07, HA, spike).
#
# Copier ce fichier en `.env` (gitignore, règle n°6 : aucun secret committé)
# et remplir les valeurs. Le script `inject-secrets.sh` charge ce `.env` puis
# lance les outils (render-compose.py, a07-rejouer-generation.py, docker compose)
# avec les secrets dans l'environnement.
#
#   cp tools/bench/.env.example tools/bench/.env
#   # remplir, puis :
#   tools/bench/inject-secrets.sh python3 tools/bench/render-compose.py --sans-pgadmin
#
# Générer un jeton HMAC solide :  openssl rand -hex 32

# Jeton d'authentification du relais (RELAY_AUTH_TOKEN / jeton_relais).
# Même valeur que le RELAY_SECRET du relais ; le portail en dérive le jeton par
# tenant. Utilisé par pile-bench.json (jeton_relais) et a07-rejouer-generation.py.
AMANE_RELAY_AUTH_TOKEN=

# Jeton d'enregistrement des machines (REGISTRATION_TOKEN).
AMANE_REGISTRATION_TOKEN=

# Mot de passe PostgreSQL du banc (user `postgres`), injecté dans les
# DATABASE_URL / PG_URL des docker-compose via ${AMANE_POSTGRES_PASSWORD}.
AMANE_POSTGRES_PASSWORD=